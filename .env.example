# Copy to .env and adjust. Never commit real secrets.
# Values shown are the defaults used when a variable is unset.

# ---------------------------------------------------------------------------
# API service (apps/api)
# ---------------------------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Required. Local dev matches infra/compose.yaml.
DATABASE_URL=postgres://streaming:streaming@127.0.0.1:5432/streaming
DATABASE_POOL_MAX=10
# Required.
REDIS_URL=redis://127.0.0.1:6379
# Per-dependency timeout for GET /readyz
READINESS_TIMEOUT_MS=1500
# Apply pending migrations at startup (single instance/dev). Prefer `pnpm db:migrate` in deployments.
MIGRATE_ON_START=false

# Integration tests (pnpm test:integration) — a database they may wipe.
# TEST_DATABASE_URL=postgres://streaming:streaming@127.0.0.1:5432/streaming_test
# TEST_REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# Media worker (apps/media-worker)
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
# Absolute origin used in playlist URLs returned by the API (e.g. https://media.example.com).
# PUBLIC_BASE_URL=
# Comma-separated origins allowed to call the API / fetch HLS (CORS), e.g. capacitor://localhost
# Used by both the API and the media worker.
ALLOWED_ORIGINS=
# HMAC key for signed playback URLs (>= 32 chars). Generate: openssl rand -base64 48
# If unset, a random key is generated per process (tokens die on restart).
STREAM_TOKEN_SECRET=
# Working directory for torrent payloads and HLS output (fast local disk).
MEDIA_WORK_DIR=./.data
# Directory containing catalog.json (+ .torrent files) = the authorized content allowlist.
CATALOG_DIR=./fixtures

HLS_SEGMENT_DURATION_SEC=6
MAX_SESSIONS=4
MAX_CONCURRENT_TRANSCODES=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 0 = let ffmpeg decide
FFMPEG_THREADS=0
X264_PRESET=veryfast
SOURCE_READ_TIMEOUT_SEC=120
SESSION_IDLE_TIMEOUT_SEC=600
JOB_IDLE_TIMEOUT_SEC=60
MAX_SEGMENTS_AHEAD=10
SEEK_RESTART_THRESHOLD=4
SEGMENT_WAIT_TIMEOUT_SEC=30
TORRENT_LINGER_SEC=300
# Released torrent data kept on disk for reuse (LRU-evicted above this). 0 disables the cache.
TORRENT_CACHE_MAX_MIB=20480
# Pieces are prioritised at most this far ahead of each reader (plus one primed window).
TORRENT_READ_WINDOW_MIB=8
MIN_FREE_DISK_MIB=2048

# BitTorrent
TORRENT_PORT=0
TORRENT_DHT=true
TORRENT_TRACKERS=true
TORRENT_WEB_SEEDS=true
# Only for local test swarms; keep false in any deployed environment (SSRF protection).
TORRENT_ALLOW_PRIVATE_PEERS=false
TORRENT_MAX_CONNS=55
# -1 = unlimited
TORRENT_UPLOAD_LIMIT_KIBPS=-1
# Dev/test only: peers to dial for every torrent, e.g. 127.0.0.1:51413
# TORRENT_BOOTSTRAP_PEERS=

# Dev seeder (pnpm seed)
# SEED_PORT=51413

# ---------------------------------------------------------------------------
# Planned (not used yet) — listed so infrastructure can be prepared
# ---------------------------------------------------------------------------
# AUTH_ACCESS_TOKEN_SECRET=                                                # M3
# AUTH_REFRESH_TOKEN_SECRET=                                               # M3
# EMAIL_PROVIDER_API_KEY=                                                  # M3
# OPENSUBTITLES_API_KEY=                                                   # M4 (optional)
# OBJECT_STORAGE_BUCKET= / OBJECT_STORAGE_* credentials                    # M8
